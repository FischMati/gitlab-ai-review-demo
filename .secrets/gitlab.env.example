# Example of the file generated by scripts/02-bootstrap-gitlab.sh.
# The real .secrets/gitlab.env is created automatically and is gitignored.
# Values below are placeholders only — do not commit real credentials.

GITLAB_URL=http://<gitlab-public-ip>
GITLAB_ROOT_PASSWORD=<generated-root-password>
GITLAB_API_TOKEN=<generated-personal-access-token>

# Appended later by scripts/03-create-project.sh:
PROJECT_ID=<numeric-project-id>
PROJECT_PATH=terraform-platform
PROJECT_HTTP_URL=http://<gitlab-public-ip>/root/terraform-platform.git
